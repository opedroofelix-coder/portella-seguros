# Site da Portella na hospedagem da DigiLocal (LiteSpeed/Apache).
# Faz aqui o papel do vercel.json: endereço oficial, redirecionamentos e tipos de arquivo.
Options -Indexes
DirectoryIndex index.html

AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest

# cabeçalhos de segurança (os mesmos do vercel.json). HSTS sem includeSubDomains: o webmail e o
# painel da DigiLocal ficam em subdomínios e não devem ser afetados.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # validação do certificado (AutoSSL) passa sem redirecionar
  RewriteRule ^\.well-known/ - [L]

  # endereço oficial: https e sem www
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://portellacorretora.com.br%{REQUEST_URI} [R=301,L]

  # /index.html (endereço do site antigo no Google) vai para a página inicial
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # /seguros também abre o CRM de Seguros
  RewriteRule ^seguros/?$ /seguro/ [R=302,L]
</IfModule>
